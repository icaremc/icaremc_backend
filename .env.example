ENVIRONMENT=1
DATABASE_URL=postgresql+asyncpg://app_user:password@localhost:5432/app_db
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=30
CORS_ALLOWED_ORIGINS=["*"]

SMS_API_BASE_URL=https://example.com
SMS_API_KEY=

CHAPA_SECRET_KEY=
CHAPA_PUBLIC_KEY=
CHAPA_WEBHOOK_SECRET=

# Firebase Cloud Messaging (FCM HTTP v1)
FIREBASE_PROJECT_ID=icaremc
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@icaremc.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_CLIENT_ID=

# Background Reminders Worker
REMINDERS_INTERVAL_HOURS=24
REMINDERS_RUN_ON_STARTUP=true
